{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WpPopPopDefinition",
  "type": "object",
  "properties": {
    "meta": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "width": {
          "type": "integer",
          "default": 640
        },
        "height": {
          "type": "integer",
          "default": 400
        },
        "overlay_color": {
          "type": "string",
          "default": "rgba(0,0,0,0.6)"
        }
      },
      "required": [
        "title",
        "width",
        "height"
      ]
    },
    "triggers": {
      "type": "object",
      "properties": {
        "on_load": {
          "type": "boolean",
          "default": true
        },
        "on_exit": {
          "type": "boolean",
          "default": false
        },
        "on_scroll": {
          "type": "integer",
          "default": 0
        },
        "on_idle": {
          "type": "integer",
          "default": 0
        }
      }
    },
    "elements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "input",
              "button",
              "image",
              "html"
            ]
          },
          "left": {
            "type": "integer"
          },
          "top": {
            "type": "integer"
          },
          "width": {
            "type": "integer"
          },
          "height": {
            "type": "integer"
          },
          "content": {
            "type": "string"
          },
          "styles": {
            "type": "object"
          }
        },
        "required": [
          "id",
          "type",
          "left",
          "top"
        ]
      }
    }
  },
  "required": [
    "meta",
    "triggers",
    "elements"
  ]
}